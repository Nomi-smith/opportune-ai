APP_ENV=development

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Search providers
OPENROUTER_SEARCH_MODEL=openrouter/free
OPENROUTER_SEARCH_ENGINE=auto
SERPER_API_KEY=

# Performance controls
SEARCH_PROVIDER_TIMEOUT=8
GEMINI_SEARCH_TIMEOUT=8
OPPORTUNITY_QUERY_EXPANSION=0
OPENROUTER_LLM_MODEL=openrouter/free

# Deployment: give every visitor a private guest profile (auto-on for Streamlit Community Cloud).
# Leave unset locally so your CV survives a browser refresh. Set to 1 to force private sessions, 0 to force shared.
PRIVATE_SESSIONS=
